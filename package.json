{
	"name": "series-container",
	"private": true,
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"workspaces": [
		"packages/renderer",
		"packages/editor"
	],
	"scripts": {
		"site:dev": "npm run dev --workspace @series-container/renderer -- --content ../../content",
		"site:build": "npm run build --workspace @series-container/renderer -- --content ../../content",
		"site:preview": "npm run preview --workspace @series-container/renderer -- --content ../../content",
		"editor:dev": "npm run dev --workspace @series-container/editor",
		"test": "npm run test --workspace @series-container/editor"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	},
	"devDependencies": {
		"marked": "^18.0.13"
	}
}
