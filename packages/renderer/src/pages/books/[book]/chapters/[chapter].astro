---
// Book preset: one chapter at /books/<book>/chapters/<NN>-<topic>/.
import { render } from 'astro:content';
import { Dot } from 'lucide-astro';
import Base from '../../../../layouts/Base.astro';
import ChapterNavItem from '../../../../components/ChapterNavItem.astro';
import {
	directBookHref,
	directChapterHref,
	getDirectBook,
	getDirectBooks,
	getDirectChaptersInBook,
	getSeriesHome,
	siteHref,
} from '../../../../lib/platform';
import type { SeqItem } from '../../../../lib/platform';

export async function getStaticPaths() {
	// Only generates pages when the content folder uses the book preset.
	const home = await getSeriesHome();
	if (!home) return [];
	const out = [];
	for (const book of await getDirectBooks()) {
		const chapters = await getDirectChaptersInBook(book.id);
		for (const chapter of chapters) {
			const name = chapter.id.split('/')[1];
			out.push({ params: { book: book.id, chapter: name } });
		}
	}
	return out;
}

const { book: bookKey = '', chapter: chapterName = '' } = Astro.params;
const home = await getSeriesHome();
const book = await getDirectBook(bookKey);
const root = siteHref('/');

const books = await getDirectBooks();
const nextBook =
	books.findIndex((b) => b.id === bookKey) >= 0 &&
	books.findIndex((b) => b.id === bookKey) < books.length - 1
		? books[books.findIndex((b) => b.id === bookKey) + 1]
		: undefined;
const inBook = bookKey ? await getDirectChaptersInBook(bookKey) : [];
const curIdx = inBook.findIndex((c) => c.id.split('/')[1] === chapterName);
const chapter = curIdx >= 0 ? inBook[curIdx] : undefined;
const isFirst = curIdx === 0;
const isLast = curIdx === inBook.length - 1;

const { Content } = chapter ? await render(chapter) : { Content: undefined };
const num = String(chapter?.data.order ?? 0).padStart(2, '0');

const prev: SeqItem | undefined = !chapter
	? undefined
	: isFirst
		? book
			? {
					bookId: book.id,
					bookKey,
					bookTitle: book.data.shortTitle,
					num: 0,
					title: book.data.title,
					href: directBookHref(bookKey),
				}
			: undefined
		: (() => {
				const c = inBook[curIdx - 1];
				return {
					bookId: bookKey,
					bookKey,
					bookTitle: book!.data.shortTitle,
					num: c.data.order,
					title: c.data.title,
					href: directChapterHref(bookKey, c.id.split('/')[1]),
				};
			})();

const next: SeqItem | undefined = !chapter
	? undefined
	: isLast
		? nextBook
			? {
					bookId: nextBook.id,
					bookKey: nextBook.id,
					bookTitle: nextBook.data.shortTitle,
					num: 0,
					title: nextBook.data.title,
					href: directBookHref(nextBook.id),
				}
			: undefined
		: (() => {
				const c = inBook[curIdx + 1];
				return {
					bookId: bookKey,
					bookKey,
					bookTitle: book!.data.shortTitle,
					num: c.data.order,
					title: c.data.title,
					href: directChapterHref(bookKey, c.id.split('/')[1]),
				};
			})();

const title = home?.data.title ?? 'Chapter';
const footer = home?.data.footer ?? title;
const backLabel = home?.data.backLabel ?? 'Home';
---

<Base
	title={chapter ? `${num} · ${chapter.data.title}` : 'Not found'}
	description={home?.data.description}
	brand={title}
	brandHref={root}
	read
	footerText={footer}
	footerLinks={[{ label: backLabel, href: root }]}
	nav={[
		{ label: 'Home', href: root, exact: true },
		{ label: 'Books', href: siteHref('/books') },
	]}
>
	{chapter && book && Content ? (
		<>
			<nav class="breadcrumbs" aria-label="Breadcrumb">
				<a href={root}>Home</a> / <a href={siteHref('/books')}>Books</a> /
				<a href={directBookHref(bookKey)}>{book.data.title}</a> / {chapter.data.title}
			</nav>

			<header class="book-head">
				<div class="book-head__number">
					{book.data.shortTitle}
					<Dot size={13} aria-hidden="true" />
					Chapter {num}
				</div>
				<h1>{chapter.data.title}</h1>
				<div class="meta-line">
					<a class="back-link" href={directBookHref(bookKey)}>
						Back to {book.data.title}
					</a>
				</div>
			</header>

			<div class="prose"><Content /></div>

			{
				(prev || next) && (
					<nav class="book-nav" aria-label="Chapter navigation">
						{prev && (
							<ChapterNavItem
								item={prev}
								dir="prev"
								currentBookId={book.id}
								label={isFirst ? 'Back to book' : undefined}
							/>
						)}
						{next && (
							<ChapterNavItem
								item={next}
								dir="next"
								currentBookId={book.id}
								label={isLast ? 'Next book' : undefined}
							/>
						)}
					</nav>
				)
			}
		</>
	) : (
		<p>Not found.</p>
	)}
</Base>

<script>
	// Wire up CodeReveal copy buttons (present on rendered markdown content).
	const buttons = document.querySelectorAll('.code-reveal__copy');
	for (const btn of buttons) {
		btn.addEventListener('click', async (event) => {
			event.preventDefault();
			event.stopPropagation();
			const details = btn.closest('.code-reveal');
			const code = details?.querySelector('.code-reveal__body code');
			if (!code) return;
			try {
				await navigator.clipboard.writeText(code.textContent ?? '');
				btn.textContent = 'Copied';
				btn.classList.add('copied');
				setTimeout(() => {
					btn.textContent = 'Copy';
					btn.classList.remove('copied');
				}, 1500);
			} catch {
				const range = document.createRange();
				range.selectNodeContents(code);
				const selection = window.getSelection();
				selection?.removeAllRanges();
				selection?.addRange(range);
			}
		});
	}
</script>
